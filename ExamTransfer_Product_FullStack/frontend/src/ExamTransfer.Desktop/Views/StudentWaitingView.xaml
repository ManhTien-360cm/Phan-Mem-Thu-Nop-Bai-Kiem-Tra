<UserControl x:Class="ExamTransfer.Desktop.Views.StudentWaitingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Phòng chờ"
                           Style="{StaticResource DisplayTitleText}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Theo dõi trạng thái duyệt và kiểm tra thiết bị trước khi kỳ thi bắt đầu."
                           Style="{StaticResource BodyText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0" />
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Join status Hero -->
                <Border Style="{DynamicResource Card}" Padding="20">
                    <StackPanel>
                        <!-- Room Code section -->
                        <TextBlock Text="MÃ PHÒNG HIỆN TẠI"
                                   Style="{StaticResource LabelText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding RoomCodeDisplay, Mode=OneWay}"
                                   FontSize="42"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Text="{Binding RoomCodeHint, Mode=OneWay}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        
                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,24,0,24" />
                        
                        <!-- Student Info -->
                        <TextBlock Text="Thông tin kết nối"
                                   Style="{StaticResource SectionTitleText}"
                                   Margin="0,0,0,16" />
                        <Border Style="{DynamicResource SubtleCard}"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="10"
                                        Background="{DynamicResource PrimarySoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE77B;"
                                               Style="{StaticResource IconText}"
                                               FontSize="17"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CandidateNameDisplay, Mode=OneWay}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StudentCodeDisplay, Mode=OneWay, StringFormat=Mã sinh viên: {0}}"
                                               Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Device -->
                        <Border Style="{DynamicResource SubtleCard}"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="10"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE7F4;"
                                               Style="{StaticResource IconText}"
                                               FontSize="17"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceNameDisplay, Mode=OneWay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DeviceIdDisplay, Mode=OneWay, StringFormat=Thiết bị: {0}}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DeviceIdDisplay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Status -->
                        <Border Style="{DynamicResource SubtleCard}"
                                Padding="14"
                                Margin="0,0,0,24"
                                Background="{DynamicResource InfoSoftBrush}"
                                BorderBrush="{DynamicResource InfoBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE975;"
                                               Style="{StaticResource IconText}"
                                               FontSize="17"
                                               Foreground="{DynamicResource InfoBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ParticipantStatusDisplay, Mode=OneWay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InfoBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ConnectionDetailDisplay, Mode=OneWay}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource InfoBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Kiểm tra lại"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="44" />
                            <Button Grid.Column="2" Content="Rời phòng"
                                    Command="{Binding LeaveCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Height="44" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Device readiness -->
                <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Sẵn sàng thiết bị"
                                   Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Hệ thống sẽ tự động bắt đầu khi giáo viên phát đề"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,24" />
                        
                        <StackPanel>
                            <Border Style="{DynamicResource SubtleCard}" Margin="0,0,0,10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Kết nối LAN/Wi-Fi" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource SubtleCard}" Margin="0,0,0,10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Quyền ghi thư mục làm bài" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource SubtleCard}" Margin="0,0,0,10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Dung lượng trống" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <Border Style="{DynamicResource SubtleCard}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Phiên bản ứng dụng tương thích" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        
                        <Border Style="{DynamicResource SubtleCard}" Margin="0,24,0,0" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource InfoBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Không đóng ứng dụng trong khi đang chờ duyệt." Style="{StaticResource BodyText}" Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="4" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="3" Height="20" CornerRadius="2" Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
