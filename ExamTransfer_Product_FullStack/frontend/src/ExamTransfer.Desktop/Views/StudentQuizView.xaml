<UserControl x:Class="ExamTransfer.Desktop.Views.StudentQuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16,20,16" MaxWidth="1000" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Thi trắc nghiệm" Style="{StaticResource DisplayTitleText}"/>
                <TextBlock Text="Đáp án được lưu cục bộ trước, đồng bộ theo revision và chấm trên máy chủ." Style="{StaticResource BodyText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding TimeLeft}" FontFamily="Consolas" FontWeight="Bold"/>
                    <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ClockStatus}" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"/>
                </WrapPanel>
            </StackPanel>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Mở / làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="4"/>
                <Button Content="Đồng bộ" Command="{Binding SyncCommand}" Style="{StaticResource SecondaryButton}" Margin="4"/>
                <Button Command="{Binding FinalizeCommand}" Style="{StaticResource PrimaryButton}" Margin="4" Height="46" Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Margin="0,0,8,0" FontSize="16"/>
                        <TextBlock Text="Chốt bài" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Content="Về kỳ thi hiện tại"
                        Command="{Binding ExitQuizCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="4"/>
                <Button Content="Xem bài trắc nghiệm đã làm"
                        Command="{Binding ReviewCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="4"/>
            </WrapPanel>
        </Grid>
        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">
            <ItemsControl ItemsSource="{Binding Review.Questions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="24">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}">
                                    <Run Text="Câu "/><Run Text="{Binding Order}"/>
                                    <Run Text=" · "/><Run Text="{Binding EarnedPoints}"/>
                                    <Run Text="/"/><Run Text="{Binding Points}"/><Run Text=" điểm"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                                           FontSize="18" Margin="0,10,0,14"/>
                                <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="{DynamicResource SurfaceSubtleBrush}"
                                                    Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="False">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                    </CheckBox>
                                                    <TextBlock Grid.Row="1" Margin="24,5,0,0"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Correct, StringFormat=Đáp án đúng: {0}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Questions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="24">
                            <StackPanel>
                                <Border Background="{DynamicResource InfoSoftBrush}" HorizontalAlignment="Left" Padding="12,4" CornerRadius="6" Margin="0,0,0,16">
                                    <TextBlock Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" FontSize="12">
                                        <Run Text="Câu "/>
                                        <Run Text="{Binding Order}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Points}"/>
                                        <Run Text=" điểm"/>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="18" LineHeight="26" Margin="0,0,0,16"/>
                                <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="{DynamicResource SurfaceSubtleBrush}" Margin="0,0,0,8">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding DataContext.CanEditAnswers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Padding="12" FontSize="15" Margin="0" HorizontalAlignment="Stretch" VerticalContentAlignment="Center">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Height="20" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Result}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ReviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ReviewComment}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
