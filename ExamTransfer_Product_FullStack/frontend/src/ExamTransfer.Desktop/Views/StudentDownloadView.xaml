<UserControl x:Class="ExamTransfer.Desktop.Views.StudentDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <Grid Margin="20,16,20,16" MaxWidth="1280" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Nhận đề thi"
                           Style="{StaticResource DisplayTitleText}" />
                <TextBlock Text="Tải manifest và file đề, tiếp tục tải khi gián đoạn và chỉ mở sau khi xác minh toàn vẹn dữ liệu."
                           Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
            <WrapPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Tải manifest"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="4" />
                <Button Command="{Binding DownloadAllCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="4" Height="46" Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" Margin="0,0,8,0" FontSize="18"/>
                        <TextBlock Text="Tải tất cả" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="0.7*" />
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Danh sách file từ máy chủ"
                               Style="{StaticResource SectionTitleText}"
                               Margin="24,20,24,12" />
                               
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Files}"
                              SelectedItem="{Binding SelectedFile}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              BorderThickness="0,1,0,0"
                              BorderBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN FILE" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding SizeBytes}" Width="120" />
                            <DataGridTextColumn Header="MIME" Binding="{Binding MimeType}" Width="160" />
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceSubtleBrush}" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tiến trình tải" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <ProgressBar Grid.Column="1"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         Height="12"
                                         Foreground="{DynamicResource PrimaryBrush}"
                                         Background="{DynamicResource OverlaySoftBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Destination panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Nơi lưu đề"
                               Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Thư mục đích lưu trữ file đề trên máy cá nhân"
                               Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,20" />
                               
                    <TextBlock Text="Thư mục đích"
                               Style="{StaticResource LabelText}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Destination}" IsReadOnly="True" />
                    
                    <Button Content="Chọn thư mục"
                            Command="{Binding BrowseCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,12,0,0" />
                            
                    <Border Margin="0,32,0,0" Padding="0,0,0,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBlock Text="Hành động" Style="{StaticResource SectionTitleText}" />
                    </Border>
                    
                    <Button Content="Tải file đã chọn"
                            Command="{Binding DownloadCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,16,0,0" />
                            
                    <Border Style="{StaticResource SubtleCard}" Margin="0,24,0,0" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource InfoBrush}" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                            <TextBlock Grid.Column="1" Text="Ứng dụng tải theo stream và không giữ toàn bộ file trong RAM. File chỉ được dùng sau khi máy chủ trả về dữ liệu đầy đủ và khớp mã SHA-256."
                                       Style="{StaticResource BodyText}" Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="3" Height="20" CornerRadius="2" Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
