# ============================================================
# EXAMTRANSFER BACKEND - DOCKER ENVIRONMENT TEMPLATE
# Copy this file to .env.docker or run:
#   powershell -ExecutionPolicy Bypass -File .\scripts\setup-docker-environment.ps1
# Never commit .env.docker to GitHub.
# ============================================================

ASPNETCORE_ENVIRONMENT=Development

# Backend container ports. Keep these aligned with compose.yaml.
Server__Port=5048
Server__UseHttps=false
Server__PreferredIp=

# LAN discovery. For same-machine testing, this can stay enabled.
# For multi-machine LAN testing, set Server__PreferredIp to the Windows host LAN IP.
Discovery__Enabled=true
Discovery__Protocol=UdpBroadcast
Discovery__Port=40550

# Explicit client LAN ranges are mandatory in Docker. Add one entry per LAN.
LanAccess__AllowedCidrs__0=192.168.1.0/24
# Docker Desktop may replace client addresses with its gateway. Keep this false
# unless configure-docker-lan.ps1 verified the Windows Private/LocalSubnet rules.
LanAccess__TrustDockerDesktopNat=false
# LanAccess__TrustedDockerGatewayCidrs__0=192.168.65.1/32

# Persistent container storage. Docker named volumes mount these locations.
Storage__RootPath=/data/ExamTransfer
Storage__MinFreeBytes=1073741824

# Stable signing keys. Generate unique values with setup-docker-environment.ps1.
Security__TokenSigningKey=REPLACE_WITH_RANDOM_BASE64_KEY
Security__ReceiptSigningKey=REPLACE_WITH_RANDOM_BASE64_KEY

# Supabase cloud configuration.
Cloud__Enabled=false
Cloud__Environment=Development
Cloud__AccessMode=UserSession
Cloud__SupabaseUrl=https://YOUR_PROJECT_REF.supabase.co
Cloud__PublishableKey=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
Cloud__OrganizationId=REPLACE_WITH_EXAMTRANSFER_ORGANIZATION_GUID
Cloud__Schema=public
Cloud__ExamBucket=exam-archives
Cloud__SubmissionBucket=submission-archives
Cloud__ExportBucket=report-exports
Cloud__BackupBucket=backup-archives
Cloud__UseResumableUploads=true
Cloud__PersistUserSession=true
Cloud__SecretKeyEnvironmentVariable=EXAMTRANSFER_SUPABASE_SECRET_KEY
Cloud__ServiceRoleEnvironmentVariable=EXAMTRANSFER_SUPABASE_SERVICE_KEY

# Leave empty in UserSession mode. Only trusted backend/maintainer machines
# should receive secret or service-role keys.
EXAMTRANSFER_SUPABASE_SECRET_KEY=
EXAMTRANSFER_SUPABASE_SERVICE_KEY=
